{
  "expo": {
    "name": "Science Museum",
    "slug": "museum-ticketing",
    "version": "2.0.0",
    "scheme": "museum",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d3b36"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used only to scan visitors' ticket QR codes."
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "et.museum.tickets",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "et.museum.tickets",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d3b36"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://museum-ticketing.vercel.app",
      "eas": {
        "projectId": "698f5733-f160-49ed-8b83-dbe6955aee78"
      }
    }
  }
}
