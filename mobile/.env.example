# Copy to .env, then restart Expo with:  npm run start:clear
#
# The API address the PHONE can reach (a phone cannot use "localhost"):
#   same Wi-Fi, no payments needed:   http://192.168.1.10:4000       (your computer's LAN address)
#   with Chapa payments (needs https): https://your-name.trycloudflare.com   or   https://xxxx.ngrok-free.app
#   Android emulator:                 http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=https://your-api-address-here
