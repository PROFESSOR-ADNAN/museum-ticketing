# Copy to .env, then restart Expo with:  npm run start:clear     (values are read when Expo starts)
#
# The API address the PHONE can reach (a phone cannot use the computer's "localhost" unless you forward the port):
#   SSH RemoteForward 4000 localhost:4000 (phone <- laptop):     http://localhost:4000
#   same Wi-Fi, no payments needed:                             http://192.168.1.10:4000       (your computer's LAN address)
#   with Chapa payments over a tunnel (needs https):            https://your-name.trycloudflare.com   or   https://xxxx.ngrok-free.app
#   Android emulator:                                           http://10.0.2.2:4000
# Check it: the Login screen and the Account tab show this address and whether the server answers.
EXPO_PUBLIC_API_URL=https://your-api-address-here
