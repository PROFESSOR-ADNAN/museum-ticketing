# =======================================================================
# Render Environment Variables (Copy & paste into Render Dashboard)
# =======================================================================

NODE_ENV=production
PORT=10000
TRUST_PROXY=1

# Generate a strong 32+ character random string
JWT_SECRET=super-secret-random-jwt-key-min-32-chars-long-12345

# Database URL:
# If using Render's managed PostgreSQL, Render provides this automatically.
# If using external Neon/Supabase PostgreSQL:
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Public URLs:
# Replace 'museum-ticketing-api' with your actual Render service name
PUBLIC_API_URL=https://museum-ticketing-api.onrender.com
# Your frontend URL (e.g. on Vercel)
WEB_URL=https://museum-ticketing-liart.vercel.app
CORS_ORIGINS=https://museum-ticketing-liart.vercel.app,https://museum-ticketing.vercel.app

# ---- Chapa Payments ----
PAYMENT_PROVIDER=chapa
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_hash
CHAPA_BASE_URL=https://api.chapa.co/v1

# ---- Notifications (Gmail SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=iam.professor.adnan@gmail.com
SMTP_PASS=your-16-char-google-app-password
MAIL_FROM="Science Museum <iam.professor.adnan@gmail.com>"

# ---- SMS Gateway (AfroMessage Ethiopia) ----
SMS_API_URL=https://api.afromessage.com/api/send
SMS_API_KEY=your_afromessage_api_key

# Default password for seeded staff accounts (admin@museum.test, etc.)
SEED_PASSWORD=admin1234
