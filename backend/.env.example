NODE_ENV=development
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# ---- Database (SQLite: one file, no database server to install) ----
DB_PATH=./data/museum.sqlite
BACKUP_DIR=./data/backups
BACKUP_KEEP=30
# Ed25519 key that signs the QR codes on receipts. Created automatically on first start. BACK IT UP with the database.
TICKET_KEY_PATH=./data/ticket-signing-key.pem

# ---- Public addresses ----
# PUBLIC_API_URL must be reachable by Chapa (webhook + return redirect) and by the phones running the mobile app.
# Locally use an https tunnel (ngrok / cloudflared) pointing at this API: e.g. https://abc123.ngrok-free.app
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Set to 1 when the API sits behind ngrok / cloudflared / nginx (so rate limits see the real client address)
TRUST_PROXY=1

# ---- Chapa (https://dashboard.chapa.co -> Settings -> API) ----
PAYMENT_PROVIDER=chapa
# Test key starts with CHASECK_TEST-, live key with CHASECK-
CHAPA_SECRET_KEY=
# The "secret hash" you type into Chapa dashboard -> Settings -> Webhooks (any long random string)
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co/v1

# ---- Notifications (optional; messages are printed to the console when unset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Science Museum <no-reply@example.org>"
SMS_API_URL=
SMS_API_KEY=

# Seed accounts password
SEED_PASSWORD=Passw0rd!
